# DatoCMS Content Delivery API token — powers the blog. Read-only.
DATOCMS_API_TOKEN=

# HubSpot private app token. Needed by the demo, support and newsletter forms
# in src/app/actions/hubspot.ts. Leave it blank outside production: with no
# token the CRM calls short-circuit and nothing is written, so local and
# staging submissions don't pollute the live pipeline.
HUBSPOT_ACCESS_TOKEN=

# FirstPromoter account id (cgv2siua in production). Records affiliate clicks so
# the app can credit the affiliate at signup. Leave blank outside production.
NEXT_PUBLIC_FIRSTPROMOTER_CID=

# Termly website UUID (Termly dashboard → your website). Loads the consent
# banner and its resource blocker, which holds GA4 and the Meta Pixel (and other
# third-party trackers) back until the visitor consents. GA4 and the Pixel below
# are not rendered at all unless this is set.
NEXT_PUBLIC_TERMLY_WEBSITE_UUID=

# GA4 measurement id (G-XXXXXXXXXX), from GA Admin → Data streams → Web.
# Leave blank outside production.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel id, from Meta Events Manager → Data sources. Leave blank outside
# production.
NEXT_PUBLIC_META_PIXEL_ID=
